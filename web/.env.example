# Server-only. Never prefix these with NEXT_PUBLIC_.
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=
# GITHUB_WORKFLOW=run-market-analysis.yml
# GITHUB_REF=main
# Private Blob via Vercel OIDC (production). BLOB_STORE_ID is provided by the
# connected Blob store. VERCEL_OIDC_TOKEN is injected by Vercel at runtime.
# BLOB_STORE_ID=
# Optional local/dev fallback only. Not required on Vercel when OIDC + store id
# are available, and must not be stored as a GitHub Actions secret.
# BLOB_READ_WRITE_TOKEN=
# Public URL used by GitHub Actions to call the run-finalize control plane.
# APP_BASE_URL=https://your-production-domain.example
# PUBLIC_RUN_COOLDOWN_SECONDS=900
# PUBLIC_RUN_DAILY_QUOTA=3
# REPORT_ACCESS_TTL_SECONDS=604800
# ANALYSIS_SESSION_COMPLETE_HOUR_ET=16
# CLIENT_HASH_SALT=
# Optional admin force-refresh only. Not used by public Run Analysis.
# RUN_ANALYSIS_SECRET=
